  "panels": [
    {
      "title": "Processamento por segundo",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "aporia-prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tracking_packets_processed_total[$__rate_interval]))",
          "legendFormat": "{{component}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aporia-prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
