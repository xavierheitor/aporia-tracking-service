{
  "uid": "tracking-jvm",
  "title": "05 — JVM and Infrastructure",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "aporia",
    "tracking"
  ],
  "panels": [
    {
      "title": "CPU do processo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aporia-prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage{application=\"aporia-tracking-service\"} * 100",
          "legendFormat": "{{component}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aporia-prometheus"
          },
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
