      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "title": "Pacotes pendentes",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "aporia-prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "tracking_queue_packets_pending and on(job,instance) ((tracking_queue_snapshot_available == 1) and (tracking_queue_snapshot_age_seconds < 90))",
          "legendFormat": "{{component}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aporia-prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
