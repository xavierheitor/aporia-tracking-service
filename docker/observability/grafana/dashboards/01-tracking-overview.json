        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "title": "Idade do snapshot",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "aporia-prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "tracking_queue_snapshot_age_seconds",
          "legendFormat": "{{component}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aporia-prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 4,
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      }
