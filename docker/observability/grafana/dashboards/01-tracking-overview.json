{
  "uid": "tracking-overview",
  "title": "01 — Tracking Overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "aporia",
    "tracking"
  ],
  "panels": [
    {
      "title": "Serviços disponíveis",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "aporia-prometheus"
      },
      "description": "Esperado: 3 em instalação de instância única.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=~\"tracking-(gateway|worker|monitor)\"})",
          "legendFormat": "{{component}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aporia-prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "title": "Sessões locais",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "aporia-prometheus"
      },
      "description": "Soma de sessões locais, não dispositivos únicos entre réplicas.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(tracking_devices_connected)",
          "legendFormat": "{{component}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aporia-prometheus"
