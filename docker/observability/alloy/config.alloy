logging {
  level  = "info"
  format = "json"
}

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

discovery.relabel "aporia_containers" {
  targets = discovery.docker.containers.targets

  // Coleta somente containers dos projetos Aporia.
  rule {
    source_labels = [
      "__meta_docker_container_label_com_docker_compose_project",
    ]

    regex  = "aporia-.*"
    action = "keep"
  }

  // Evita ciclos de realimentação dos logs.
  rule {
    source_labels = [
      "__meta_docker_container_label_com_docker_compose_project",
      "__meta_docker_container_label_com_docker_compose_service",
    ]

    separator = ";"
    regex     = "aporia-observability;(loki|alloy)"
    action    = "drop"
  }

  // Identificação do projeto.
  rule {
    source_labels = [
      "__meta_docker_container_label_com_docker_compose_project",
    ]

    target_label = "project"
  }

  // Identificação do serviço.
  rule {
    source_labels = [
      "__meta_docker_container_label_com_docker_compose_service",
    ]

    target_label = "service"
  }

  // Identificação utilizada pelo Grafana Logs Drilldown.
  rule {
    source_labels = [
      "__meta_docker_container_label_com_docker_compose_service",
    ]

    target_label = "service_name"
  }

  // Identificação do container.
  rule {
    source_labels = [
      "__meta_docker_container_name",
    ]

    regex        = "/(.*)"
    target_label = "container"
  }
}

loki.source.docker "aporia_logs" {
  host = "unix:///var/run/docker.sock"

  targets = discovery.relabel.aporia_containers.output

  forward_to = [
    loki.process.aporia_logs.receiver,
  ]
}

loki.process "aporia_logs" {
  stage.json {
    expressions = {
      level = "level",
    }
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  forward_to = [
    loki.write.local.receiver,
  ]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}