TRACKING_DB_URL=jdbc:postgresql://localhost:55434/aporia_tracking_v2
TRACKING_DB_USER=tracking
TRACKING_DB_PASSWORD=
TRACKING_TCP_PORT=5500

# JDBC usado pelos contêineres. TRACKING_DB_URL acima serve para a JVM no host.
TRACKING_CONTAINER_DB_URL=jdbc:postgresql://postgres:5432/aporia_tracking_v2
TRACKING_DATABASE_PORT=55434
TRACKING_DATABASE_NETWORK=aporia-tracking-db_default
# Habilite somente para transmitir comandos. Para desabilitar, remova a variável.
# TRACKING_DISPATCH_OWNER_FILE=/var/lib/aporia-dispatch/owner
