# Development database
TRACKING_DB_URL=jdbc:postgresql://127.0.0.1:5437/aporia_tracking
TRACKING_CONTAINER_DB_URL=jdbc:postgresql://postgres:5432/aporia_tracking
TRACKING_ADMIN_DB_USER=tracking_admin
TRACKING_ADMIN_DB_PASSWORD=

# Runtime credentials
TRACKING_GATEWAY_DB_PASSWORD=
TRACKING_WORKER_DB_PASSWORD=

# Integration tests
TRACKING_TEST_DB_URL=jdbc:postgresql://127.0.0.1:15437/aporia_tracking_test
TRACKING_TEST_DB_USER=tracking_test_admin
TRACKING_TEST_DB_PASSWORD=

# TCP gateway
TRACKING_TCP_PORT=5500
TRACKING_TCP_BIND=0.0.0.0
TRACKING_PUBLISH_ADDRESS=127.0.0.1
TRACKING_PROTOCOL=auto
TRACKING_TCP_SESSION_IDLE_SECONDS=180

# Connection pool
TRACKING_DB_POOL_MAX=10
TRACKING_DB_POOL_MIN=2

# HTTP
TRACKING_HTTP_PORT=8080
TRACKING_HTTP_BIND=127.0.0.1

# Observability
TRACKING_MANAGEMENT_BIND=127.0.0.1

# Monitoring authentication
TRACKING_MONITORING_USER=monitoring
TRACKING_MONITORING_PASSWORD=

# Timeout Config
TRACKING_DB_CONNECTION_TIMEOUT_MS=3000
TRACKING_DB_VALIDATION_TIMEOUT_MS=1000

TRACKING_WORKER_HEARTBEAT_TIMEOUT_SECONDS=60

TRACKING_MONITOR_DB_USER=tracking_monitor
TRACKING_MONITOR_DB_PASSWORD=
TRACKING_QUEUE_COLLECTION_INTERVAL_MS=30000
TRACKING_QUEUE_QUERY_TIMEOUT_SECONDS=3

# Container resources

TRACKING_GATEWAY_MEMORY=512m
TRACKING_GATEWAY_CPUS=1.0

TRACKING_WORKER_MEMORY=512m
TRACKING_WORKER_CPUS=1.0

TRACKING_MONITOR_MEMORY=384m
TRACKING_MONITOR_CPUS=0.5

# Management ports

TRACKING_GATEWAY_MANAGEMENT_PORT=9101
TRACKING_WORKER_MANAGEMENT_PORT=9102
TRACKING_MONITOR_MANAGEMENT_PORT=9104

# Observability

OBSERVABILITY_PUBLISH_ADDRESS=127.0.0.1

PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=5GB

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

ALERTMANAGER_PORT=9093

OBSERVABILITY_UID=1000
OBSERVABILITY_GID=1000

# GlitchTip local
GLITCHTIP_PORT=8000
GLITCHTIP_DOMAIN=http://localhost:8000
GLITCHTIP_ALLOWED_HOSTS=localhost,127.0.0.1,glitchtip
GLITCHTIP_DB_NAME=glitchtip
GLITCHTIP_DB_USER=glitchtip
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_SECRET_KEY=

# Application error tracking
TRACKING_SENTRY_DSN=
TRACKING_CONTAINER_SENTRY_DSN=
TRACKING_SENTRY_ENVIRONMENT=development
TRACKING_SENTRY_RELEASE=1.0-SNAPSHOT